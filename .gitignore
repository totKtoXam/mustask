# .NET
bin/
obj/
*.user
*.suo
.vs/
artifacts/
TestResults/
*.binlog

# Aspire
**/apphost.env

# The Keycloak provider's Maven output, should anyone build it outside the
# image (ADR-0025 § 1 builds it only inside deploy/keycloak/Dockerfile).
deploy/keycloak/providers/*/target/

# Node / frontend
node_modules/
dist/
build/
coverage/
.vite/
*.local

# Python (hook scripts in .claude/hooks/)
__pycache__/
*.pyc

# The stand-only Keycloak client's secret (ADR-0023), generated by AppHost
# at every stand start — never committed, never human-set. Written by
# Mustask.AppHost, read by src/frontend/e2e's global setup.
/.e2e-stand/

# Env / secrets
.env
.env.*
!.env.example

# Editors / OS
.idea/
*.swp
.DS_Store
Thumbs.db
.claude/worktrees/

# Account-specific token rates for scripts/usage-report.py; the template
# .claude/usage-prices.example.json is committed, the filled-in copy is not.
.claude/usage-prices.json
