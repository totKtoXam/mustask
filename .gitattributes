# Normalize line endings: LF in repository, native in working copy
* text=auto

# Always LF
*.sh text eol=lf
# Git hooks are shell scripts: a CRLF hook fails on Windows because the
# interpreter treats the trailing carriage return as part of the command.
.githooks/* text eol=lf

# Always CRLF (Windows-specific scripts)
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.pdf binary
