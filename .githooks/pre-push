#!/bin/sh
# Pre-push check — a single entry point, `scripts/verify.sh`, the quick run.
#
# There used to be a fixed list of test projects here. It drifted from what
# the stages' Definition of Done requires, and couldn't do the main thing: a
# README edit would trigger a build, while a Directory.Packages.props change
# could sail through unbuilt if the list wasn't updated. verify.sh picks
# checks by the class of changed files, so the hook and the DoD now talk
# about the same thing.
#
# The hook is feedback, not the barrier (docs/conventions/git.md, "Local checks"):
# it runs verify.sh with VERIFY_TESTS=0 — the change-proportionate checks
# without a single test run (builds, lint, prose, agent instructions, shell,
# CI YAML). Tests are CI's job: the CI workflow sets VERIFY_FULL=1 and its
# check is required on main (tech-041). Until tech-041 this hook forced the
# whole frontend suite; until tech-055 it still ran the tests the branch diff
# reached, which on a full-stack branch meant the integration and volume
# suites on every push — up to hours, and red on timing-sensitive tests under
# load while the same code was green alone.
#
# The comparison base is verify.sh's own (tech-044): BASE if exported, else
# origin/main when that ref exists, else main. The hook sets none, so a push
# from a worktree is checked against what the branch changed, not against the
# hub's stale local main. The hook runs the verify.sh of the tree being pushed
# from (git rev-parse --show-toplevel), whichever checkout's copy of this hook
# core.hooksPath points at.
#
# A full run before the push stays one variable away, and the green stamp
# (scripts/verify.sh header) makes it instant when this tree already passed:
#
#   VERIFY_FULL=1 git push                       # sh
#   $env:VERIFY_FULL = 1; git push               # PowerShell

# This worktree's own copy runs (tech-060): core.hooksPath can pin another
# checkout's .githooks, whose copy may be older than this branch's; hand over
# to the copy of the tree the hook runs in. MUSTASK_OWN_HOOK stops a second
# hand-over.
own="$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/$(basename "$0")"
if [ -z "${MUSTASK_OWN_HOOK:-}" ] && [ -f "$own" ] \
    && [ "$(cd "$(dirname "$0")" && pwd -P)" != "$(cd "$(dirname "$own")" && pwd -P)" ]; then
    MUSTASK_OWN_HOOK=1 exec sh "$own" "$@"
fi

set -eu

repo=$(git rev-parse --show-toplevel)
verify="$repo/scripts/verify.sh"

if [ ! -f "$verify" ]; then
    printf '[pre-push] scripts/verify.sh not found — check skipped.\n' >&2
    exit 0
fi

# Whatever the caller exported; anything but 1 is the run without tests.
VERIFY_FULL=${VERIFY_FULL:-0}
export VERIFY_FULL

if [ "$VERIFY_FULL" = 1 ]; then
    VERIFY_TESTS=1
    printf '[pre-push] scripts/verify.sh (VERIFY_FULL=1: every test, the whole frontend suite)\n'
else
    VERIFY_TESTS=0
    printf '[pre-push] scripts/verify.sh (no tests: CI runs them on the PR; VERIFY_FULL=1 git push for a local full run)\n'
fi
export VERIFY_TESTS

if ! (cd "$repo" && sh "$verify"); then
    printf '\n[pre-push] Check failed — push stopped.\n\n' >&2
    exit 1
fi

exit 0
