<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.1" />
    <!-- tech-040: GHSA-qhrr-8q5h-9q3h (NU1902, an error under
         TreatWarningsAsErrors). Aspire.Hosting 13.5.1 reaches MessagePack
         2.5.302 through StreamJsonRpc; 2.5.303 is the fix, same release line,
         so StreamJsonRpc keeps working. Mustask.AppHost carries the explicit
         reference that makes this version win. Drop this entry and that
         reference once Aspire's own graph resolves MessagePack 2.5.303 or
         newer. Check with the AppHost reference removed: the restore raises
         no NU1902 and `dotnet list package` (flag include transitive) on the
         AppHost lists MessagePack 2.5.303+ as a transitive package. With the
         reference in place that command shows MessagePack as a top-level
         2.5.303 whatever Aspire resolves, so it proves nothing.
         CentralPackageTransitivePinningEnabled is deliberately
         off: it would apply every PackageVersion here to every project, and
         the restore fails with NU1109 on the Npgsql and
         Microsoft.Extensions.Logging.Abstractions entries. -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />

    <!-- Aspire ServiceDefaults -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />

    <!-- EF Core / PostgreSQL -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.5.1" />
    <!-- mod-014 (D-14): the stand reset's drop and create in Mustask.AppHost,
         pinned to the version Aspire.Hosting.PostgreSQL already resolves there. -->
    <PackageVersion Include="Npgsql" Version="8.0.3" />

    <!-- Пагинация/сортировка/фильтрация списочных чтений (ADR-0015) -->
    <PackageVersion Include="Gridify" Version="2.19.1" />
    <PackageVersion Include="Gridify.EntityFramework" Version="2.19.1" />

    <!-- Api -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Enrichers для структурного лога — источник конфигурации
         appsettings*.json ("Serilog:Enrich"/"Serilog:Using"), не код. -->
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <!-- Явные ссылки, а не транзитивные через Serilog.AspNetCore: типы
         грузятся по имени сборки из appsettings*.json ("Serilog:WriteTo"/"Serilog:Using"), поэтому
         молчаливый уход зависимости из Serilog.AspNetCore ронял бы старт без
         предупреждения на компиляции. Версии зафиксированы по факту (`dotnet
         list package`, флаг include transitive, на текущий Serilog.AspNetCore
         10.0.0), не подняты специально. -->
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />

    <!-- Identity / JWT -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Keycloak resource server: OpenIdConnectConfiguration/
         ConfigurationManager used directly by RealmMetadata/JwtBearerSetup
         (explicit reference for a type used directly, not only
         transitively). Version pinned to what
         Microsoft.AspNetCore.Authentication.JwtBearer 10.0.11 already
         resolves transitively (checked via `dotnet list package` with the
         include-transitive flag), so adding the explicit reference does
         not change what actually loads. -->
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
    <!-- Session module (ADR-0022): Mustask.Api is the OIDC client
         for the panel's session (AddOpenIdConnect in SessionAuthenticationSetup).
         Not part of the shared framework (Microsoft.AspNetCore.App), same as
         Microsoft.AspNetCore.Authentication.JwtBearer above — needs its own
         PackageReference/PackageVersion pair. Same
         release line as JwtBearer 10.0.11 (both ship from dotnet/aspnetcore). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- mod-014 (D-14): the opt-in live provider tests build the Keycloak image,
         pinned to the version Testcontainers.PostgreSql already resolves. -->
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
  </ItemGroup>

</Project>
