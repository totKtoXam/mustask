<Project Sdk="Aspire.AppHost.Sdk/13.5.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>d980c6f5-a334-45b5-9200-3fe7cbd98e6a</UserSecretsId>
    <!-- Aspire CLI bundle features (e.g. `aspire run`) are not used in this
         project; local orchestration goes through `dotnet run`. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <!-- mod-014: the stand reset drops and recreates the external database (Stand/StandReset.cs). -->
    <PackageReference Include="Npgsql" />
    <!-- GHSA-qhrr-8q5h-9q3h (NU1902): the MessagePack that Aspire.Hosting pulls
         in through StreamJsonRpc is raised to the version in
         Directory.Packages.props. Drop this line with that entry once Aspire's
         own graph resolves MessagePack 2.5.303 or newer (tech-040). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mustask.Api\Mustask.Api.csproj" />
  </ItemGroup>

</Project>
