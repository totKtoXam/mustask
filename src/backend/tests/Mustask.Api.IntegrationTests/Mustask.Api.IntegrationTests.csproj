<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- mod-014: the opt-in live tests run the built Keycloak image (Features/UserDirectory/Live). -->
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    mod-016: the opt-in live realm tests (Features/UserDirectory/Live) run the stand's drift check and the live-realm command
    against a real Keycloak. That is stand-only code of Mustask.AppHost, compiled in here as Mustask.Contracts.Tests does
    (see its project file for why not a ProjectReference to the Aspire host) — a second compilation of the same source, not a copy.
  -->
  <ItemGroup>
    <Compile Include="..\..\Mustask.AppHost\Provisioning\*.cs" LinkBase="Provisioning" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mustask.Api\Mustask.Api.csproj" />
    <!-- Явные ссылки: тесты создают тестовые данные напрямую через
         MustaskDbContext/MustaskDbContextFactory и доменные типы, а не
         только транзитивно через Mustask.Api. -->
    <ProjectReference Include="..\..\Mustask.Infrastructure\Mustask.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Mustask.Domain\Mustask.Domain.csproj" />
    <ProjectReference Include="..\..\Mustask.Application\Mustask.Application.csproj" />
  </ItemGroup>

</Project>
