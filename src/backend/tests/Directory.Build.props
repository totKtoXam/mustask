<Project>

  <!-- The repository-wide props (target framework, warnings as errors, coverage, git hooks) still apply. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!--
    The test kit's shared code (tech-035, docs/conventions/testing.md): the constants and the repository layout every test
    project used to copy. One compilation per project, no project of its own. TestDataNames.cs needs Mustask.Domain, which
    every test project but Mustask.Shared.Tests reaches.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\Kit\TestData.cs" Link="Shared\Kit\TestData.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\Kit\RepositoryLayout.cs" Link="Shared\Kit\RepositoryLayout.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\Kit\TestDataNames.cs" Link="Shared\Kit\TestDataNames.cs"
             Condition="'$(MSBuildProjectName)' != 'Mustask.Shared.Tests'" />
  </ItemGroup>

</Project>
