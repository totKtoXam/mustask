{
  // См. appsettings.json — под UseSerilog()
  // Logging:LogLevel не применяется, единственный источник уровней —
  // Serilog:MinimumLevel.
  //
  // Единственное отличие от прод-дефолта (appsettings.json) —
  // формат консоли. Переопределяем ключ "Serilog:WriteTo:console" (объектная
  // форма: слияние по имени, а не по позиции, переживает
  // появление соседних sink'ов в любом порядке). Тот же аргумент
  // ("formatter"), что и в базовом файле — разные имена аргументов (formatter
  // здесь и outputTemplate там) слились бы в один вызов Console(...) с обоими
  // параметрами сразу, для которого нет перегрузки — старт упал бы.
  // Mustask.Api.Logging.DevelopmentConsoleFormatter печатает время+уровень+
  // сообщение одной строкой вместо структурного JSON.
  //
  // Microsoft.EntityFrameworkCore=Warning в
  // appsettings.json — новое поведение (раньше такого override не было ни
  // в Serilog, ни в мёртвой секции Logging), нужное только в проде — в
  // Development оно молча гасило бы SQL-команды и в консоли, и в Aspire
  // dashboard (writeToProviders: true проводит фильтр Serilog и туда).
  // MinimumLevel:Override — словарь: этот ключ мержится по имени независимо
  // от WriteTo, коллизии позиционного слияния здесь нет.
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": {
      "console": {
        "Name": "Console",
        "Args": {
          "formatter": "Mustask.Api.Logging.DevelopmentConsoleFormatter, Mustask.Api"
        }
      }
    }
  },
  // Fallback-origin для CORS (см. Program.cs), на случай запуска
  // `dotnet run --project src/backend/Mustask.Api` без Aspire AppHost — совпадает
  // с dev-портом панели (`Ports:Frontend`, он же дефолт vite.config.ts).
  // При запуске через AppHost `Cors__AllowedOrigins__0` из env перекрывает
  // это значение реальным origin'ом фронта.
  // ВНИМАНИЕ: `Cors__AllowedOrigins__0` перекрывает только элемент с
  // индексом 0. Если здесь когда-нибудь появится второй origin — под
  // AppHost он не перекроется и молча переживёт запуск (расширит список
  // разрешённых origin'ов). Для одного origin (текущий случай) это не
  // проблема; при добавлении второго — либо добавить в AppHost.cs
  // `Cors__AllowedOrigins__1`, либо перейти на другую схему.
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  // Realm Mustask для запуска Mustask.Api без Mustask.AppHost (Aspire в норме
  // подставляет оба ключа переменными Keycloak__Authority/Keycloak__Audience
  // из живого контейнера, AppHost.cs). Оба обязательны — без них старт
  // падает с "Missing configuration value Keycloak:Authority."
  "Keycloak": {
    "Authority": "http://localhost:5010/realms/mustask",
    "Audience": "mustask-api",
    // ADR-0022: секрет confidential-клиента mustask-panel. Плейсхолдер
    // локального dev-запуска без AppHost; реальное значение на стенде —
    // AppHost.cs, параметр keycloak-panel-client-secret (user secrets).
    "ClientSecret": "dev-only-placeholder-secret"
  },
  // Адрес панели для абсолютного редиректа после /callback и для
  // post_logout_redirect_uri — совпадает с dev-портом
  // панели, как и fallback-origin CORS выше.
  "Session": {
    "PanelUrl": "http://localhost:3000"
  }
}
