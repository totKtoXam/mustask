{
  // Секция Logging:LogLevel сюда НЕ возвращается
  // — под UseSerilog() (SerilogLoggerFactory) её фильтры не применяются
  // вовсе, единственный источник уровней логирования — Serilog:MinimumLevel
  // ниже. Задача как раз про конфигурацию логирования — не оставляем рядом
  // вторую, нерабочую секцию с тем же смыслом (ловушка для следующего, кто
  // придёт "понизить уровень логов").
  //
  // Единственный источник конфигурации Serilog (Program.cs больше
  // не хардкодит ни sink, ни enrichers — см. UseSerilog там). Это прод-
  // дефолт: структурный JSON на консоли + enrichers для machine/env/thread.
  // appsettings.Development.json переопределяет только ключ
  // "Serilog:WriteTo:console" на человекочитаемый формат (см. комментарий
  // там и Mustask.Api.Logging.DevelopmentConsoleFormatter) — больше ничего в
  // этой секции по средам не отличается.
  //
  // WriteTo — объект с именованными ключами
  // ("console": {...}), а не позиционный массив. Serilog.Settings.Configuration
  // сливает объектную форму по имени ключа, а не по индексу элемента —
  // появление второго sink'а рядом (в любом порядке) не сдвигает "console" и
  // не ломает переопределение из appsettings.Development.json молча (было
  // воспроизведено на индексной форме — WriteTo:0 переставал быть
  // Console, если перед ним вставляли другой sink).
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName", "WithThreadId"],
    "Properties": {
      "Application": "Mustask.Api"
    },
    "WriteTo": {
      "console": {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    }
  },
  "AllowedHosts": "*"
}
