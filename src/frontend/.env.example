# Базовый URL Mustask.Api. Значение для локального запуска
# `dotnet run --project src/backend/Mustask.Api`; при запуске через Aspire AppHost
# переменная подставляется автоматически.
# Под префиксом (ADR-0037) — полный публичный адрес вместе с префиксом,
# например https://portal.devexpert.kz/mustask; клиент дописывает /api/...
VITE_API_BASE_URL=http://localhost:5000

# Путь, под которым отдаётся панель (только сборка, ADR-0037). По умолчанию `/`.
# Принимает `/mustask` и `/mustask/`. Должен совпадать с Hosting__PathBase API.
# VITE_BASE_PATH=/mustask
