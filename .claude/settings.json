{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_wide_fs_search.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_workflow_adapters.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(git stash list:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git worktree list:*)",
      "Bash(bash scripts/verify.sh:*)",
      "Bash(bash scripts/check-gates.sh:*)",
      "Bash(bash scripts/backlog.sh:*)",
      "Bash(python scripts/validate-ai-workflow.py:*)",
      "Bash(python .claude/hooks/tests/run_cases.py:*)",
      "Bash(python .claude/hooks/tests/run_adapter_cases.py:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm run format:check:*)"
    ],
    "deny": [
      "Bash(find / *)",
      "Bash(find -L / *)",
      "Bash(find -H / *)",
      "Bash(find /c/ *)",
      "Bash(find -L /c/ *)",
      "Bash(find /c *)",
      "Bash(find /c/Users *)",
      "Bash(find ~ *)",
      "Bash(sudo find / *)",
      "PowerShell(Get-ChildItem -Path C:\\ -Recurse*)",
      "PowerShell(Get-ChildItem C:\\ -Recurse*)",
      "PowerShell(gci C:\\ -Recurse*)",
      "PowerShell(ls C:\\ -Recurse*)"
    ]
  }
}
