{
  "$comment": "feat-018 US-2/US-3: hostile payloads. Server: the stored value of each contains none of `mustNotContain` (case-insensitive substrings), holds no element or attribute outside the allow-list and, parsed again, serialised and reduced again, is identical. Panel: loading each reduced value into the editor yields a document with none of it (US-3 'Stored markup outside the subset is not rendered'). The corpus only grows: every bypass found is added here.",
  "version": 1,
  "cases": [
    { "id": "script-plain", "story": "US-2", "note": "", "input": "<p>a</p><script>alert(1)</script>", "mustNotContain": ["<script", "alert(1)"] },
    { "id": "script-nested-split", "story": "US-2", "note": "Tag split by a nested tag.", "input": "<scr<script>ipt>alert(1)</scr</script>ipt>", "mustNotContain": ["<script"] },
    { "id": "img-onerror", "story": "US-2", "note": "", "input": "<img src=x onerror=alert(1)>", "mustNotContain": ["<img", "onerror"] },
    { "id": "svg-script", "story": "US-2", "note": "", "input": "<svg><script>alert(1)</script></svg>", "mustNotContain": ["<svg", "<script", "alert(1)"] },
    { "id": "svg-style-img", "story": "US-2", "note": "Foreign content: an img is an element inside svg style.", "input": "<svg><style><img src=x onerror=alert(1)></style></svg>", "mustNotContain": ["<svg", "<style", "<img", "onerror"] },
    { "id": "math-mglyph-style", "story": "US-2", "note": "", "input": "<math><mi><mglyph><style><img src=x onerror=1></style></mglyph></mi></math>", "mustNotContain": ["<math", "<style", "<img", "onerror"] },
    { "id": "noscript-title", "story": "US-2", "note": "noscript is raw text with scripting on and markup with it off.", "input": "<noscript><p title=\"</noscript><img src=x onerror=alert(1)>\"></noscript>", "mustNotContain": ["<noscript", "<img", "onerror"] },
    { "id": "noscript-style", "story": "US-2", "note": "", "input": "<noscript><style></noscript><img src=x onerror=alert(1)>", "mustNotContain": ["<noscript", "<style", "<img", "onerror"] },
    { "id": "href-mixed-case", "story": "US-2", "note": "", "input": "<a href=\"jAvAsCrIpT:alert(1)\">x</a>", "mustNotContain": ["javascript:", "href="] },
    { "id": "href-entity-decimal", "story": "US-2", "note": "", "input": "<a href=\"&#106;avascript:alert(1)\">x</a>", "mustNotContain": ["javascript:", "href="] },
    { "id": "href-entity-hex-colon", "story": "US-2", "note": "", "input": "<a href=\"&#x6A;&#x61;vascript&colon;alert(1)\">x</a>", "mustNotContain": ["javascript:", "href="] },
    { "id": "href-embedded-newline", "story": "US-2", "note": "", "input": "<a href=\"java\nscript:alert(1)\">x</a>", "mustNotContain": ["javascript:", "href="] },
    { "id": "href-leading-control", "story": "US-2", "note": "", "input": "<a href=\"\u0001 javascript:alert(1)\">x</a>", "mustNotContain": ["javascript:", "href="] },
    { "id": "href-data", "story": "US-2", "note": "", "input": "<a href=\"data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==\">x</a>", "mustNotContain": ["data:", "href="] },
    { "id": "href-vbscript", "story": "US-2", "note": "", "input": "<a href=\"vbscript:msgbox(1)\">x</a>", "mustNotContain": ["vbscript:", "href="] },
    { "id": "style-url-javascript", "story": "US-2", "note": "", "input": "<p style=\"background:url(javascript:alert(1))\">x</p>", "mustNotContain": ["style", "javascript:", "url("] },
    { "id": "event-handler", "story": "US-2", "note": "", "input": "<p class=\"x\" onmouseover=\"alert(1)\">x</p>", "mustNotContain": ["onmouseover", "class="] },
    { "id": "dom-clobbering", "story": "US-2", "note": "ids and names that shadow document properties.", "input": "<div id=\"__proto__\" name=\"x\"><form id=\"a\"><input name=\"attributes\"></form></div><a id=\"cookie\" name=\"cookie\">y</a>", "mustNotContain": ["id=", "name=", "<form", "<input"] },
    { "id": "form-action", "story": "US-2", "note": "", "input": "<form action=\"javascript:alert(1)\"><button formaction=\"javascript:alert(1)\">x</button></form>", "mustNotContain": ["<form", "<button", "action", "javascript:"] },
    { "id": "iframe-srcdoc", "story": "US-2", "note": "", "input": "<iframe srcdoc=\"<script>alert(1)</script>\"></iframe>", "mustNotContain": ["<iframe", "srcdoc", "<script"] },
    { "id": "object-embed", "story": "US-2", "note": "", "input": "<object data=\"javascript:alert(1)\"></object><embed src=\"x\">", "mustNotContain": ["<object", "<embed", "javascript:"] },
    { "id": "template-script", "story": "US-2", "note": "", "input": "<template><script>alert(1)</script></template>x", "mustNotContain": ["<template", "<script"] },
    { "id": "script-inside-code-block", "story": "US-2", "note": "A script inside a code block is text, escaped.", "input": "<pre><code class=\"language-javascript\"><script>alert(1)</script></code></pre>", "mustNotContain": ["<script"] },
    { "id": "code-class-attribute-injection", "story": "US-2", "note": "", "input": "<pre><code class=\"language-js&quot; onclick=&quot;alert(1)\">x</code></pre>", "mustNotContain": ["onclick", "language-js"] },
    { "id": "class-style-expression", "story": "US-7", "note": "Hostile class and style values on a palette element.", "input": "<span class=\"rt-color-red\" style=\"x:expression(alert(1))\">x</span><span class=\"rt-color-red;alert(1)\">y</span>", "mustNotContain": ["style", "expression", "alert(1)\""] },
    { "id": "table-svg-onload", "story": "US-2", "note": "", "input": "<table><td><svg onload=alert(1)>", "mustNotContain": ["<svg", "onload"] },
    { "id": "comment-script", "story": "US-2", "note": "", "input": "<p>a<!--<script>alert(1)</script>-->b</p>", "mustNotContain": ["<!--", "<script"] },
    { "id": "cdata", "story": "US-2", "note": "", "input": "<![CDATA[<script>alert(1)</script>]]>", "mustNotContain": ["<![cdata", "<script"] },
    { "id": "xmp-script", "story": "US-2", "note": "Raw text elements: the markup inside is text and is escaped.", "input": "<xmp><script>alert(1)</script></xmp>", "mustNotContain": ["<script", "<xmp"] },
    { "id": "plaintext", "story": "US-2", "note": "", "input": "<plaintext><script>alert(1)</script>", "mustNotContain": ["<script", "<plaintext"] },
    { "id": "base-href", "story": "US-2", "note": "", "input": "<base href=\"javascript:alert(1)//\"><a href=\"x\">y</a>", "mustNotContain": ["<base", "javascript:", "href="] },
    { "id": "mxss-form-math", "story": "US-2", "note": "A classic mutation payload (form nesting with foreign content).", "input": "<form><math><mtext></form><form><mglyph><style></math><img src onerror=alert(1)>", "mustNotContain": ["<form", "<math", "<style", "<img", "onerror"] },
    { "id": "mxss-svg-style-id", "story": "US-2", "note": "", "input": "<svg></p><style><a id=\"</style><img src=1 onerror=alert(1)>\">", "mustNotContain": ["<svg", "<style", "<img", "onerror"] },
    { "id": "mxss-select-style", "story": "US-2", "note": "", "input": "<select><template><style></select><img src=x onerror=alert(1)></style></template></select>", "mustNotContain": ["<select", "<template", "<style", "<img", "onerror"] },
    { "id": "deep-unclosed-marks", "story": "US-2", "note": "Unclosed and misnested formatting elements.", "input": "<b><i><u><s>a</b>b</i>c</u>d</s><a href=\"https://e.org\"><a href=\"javascript:1\">x</a></a>", "mustNotContain": ["javascript:"] },
    { "id": "unicode-case-folding-scheme", "story": "US-2", "note": "A Kelvin sign and a dotless i near a scheme name.", "input": "<a href=\"javascrıpt:alert(1)\">x</a><a href=\"JAVASCRIPT:alert(1)\">y</a>", "mustNotContain": ["javascript:", "href="] }
  ]
